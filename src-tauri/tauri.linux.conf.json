{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.dedsiteam.dedsiclash",
  "bundle": {
    "targets": ["deb", "rpm"],
    "linux": {
      "deb": {
        "depends": ["openssl", "libayatana-appindicator3-1"],
        "desktopTemplate": "./packages/linux/clash-verge.desktop",
        "provides": ["dedsiclash"],
        "postInstallScript": "./packages/linux/post-install.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      },
      "rpm": {
        "depends": ["openssl", "libayatana-appindicator-gtk3"],
        "recommends": ["policycoreutils", "policycoreutils-python-utils"],
        "desktopTemplate": "./packages/linux/clash-verge.desktop",
        "provides": ["dedsiclash"],
        "postInstallScript": "./packages/linux/post-install-rpm.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      }
    },
    "externalBin": [
      "./sidecar/dedsi-clash-service",
      "./sidecar/dedsi-clash-service-install",
      "./sidecar/dedsi-clash-service-uninstall",
      "./sidecar/dedsi-mihomo",
      "./sidecar/dedsi-mihomo-alpha"
    ]
  }
}
